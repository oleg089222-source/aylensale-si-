# Copy to .env.local for local API testing (never commit real keys).
# Production keys live in Vercel → Project → Settings → Environment Variables.

# Stripe — use sk_test_… + test price for safe checkout tests
STRIPE_SECRET_KEY=sk_test_...
STRIPE_VIP_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# VIP feature toggle (default on if unset)
VIP_ENABLED=true

# Auction deposit (Stage 2) — enforcement stays OFF until explicit production sign-off
AUCTION_DEPOSITS_ENABLED=true
AUCTION_DEPOSIT_GBP=50
# AUCTION_DEPOSIT_ENFORCEMENT=false

# Firebase Admin (single-line JSON from Firebase service account)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Cloudflare Turnstile — checkout captcha (dash.cloudflare.com → Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile — spam protection on checkout (https://dash.cloudflare.com → Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
