    "icons:push-pwa": "node scripts/push-pwa-branding.mjs",
    "build": "node scripts/bundle-qrcode.mjs && node scripts/bundle-storefront-css.mjs && node scripts/bundle-storefront-js.mjs && node scripts/vercel-build.mjs && node scripts/inline-catalog-bootstrap.mjs && node scripts/smoke-check.mjs",
    "perf": "node scripts/perf-audit.mjs",
    "perf:prod": "node scripts/pagespeed-prod-audit.mjs",
    "audit:prod": "node scripts/full-prod-audit.mjs",
    "audit:lighthouse": "node scripts/lighthouse-prod-audit.mjs",
